# Python
__pycache__/
*.pyc
*.pyo

# 打包：中间产物与成品都在本地构建，不走仓库分发
build/
dist/

# 运行时存档（含个人陪伴数据：喂食/摸头计数、窗口位置等）
ejee_save.json
*.bak

# 构建日志
build_log*.txt

# —— 以下为本地开发/维护产物，不进公开仓库（文件保留在磁盘）——
# 素材管线：角色原图、4x 超分中间产物、切图与图标生成脚本、超分工具
tools/*
# 例外：叶子拆分脚本是 assets/leaf*.png、base_body.png 的唯一来源，必须入库
!tools/make_leaf_assets.py
# 例外：预览回归工具是每轮验证流程核心（--shot 比对/刷新基线），必须入库
!tools/check_preview.py
# 例外：Git Data API 备用推送通道（代理拦 443 时兜底），必须入库
!tools/push_via_api.py
# 例外：未定义名静态检查（每轮验证流程第 0 步：拆文件丢 import 防线），必须入库
!tools/undef_check.py
# 各状态预览图（--shot 生成）与回归基准，仅本地参考
previews/
_baseline/

# 临时脚本 / 原型 / 推送工具
.tmp/
